{
  "name": "appproxy",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code icin sifir bagimlilikli proxy: gemini / openrouter / nvidia giris noktalari",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "claude-gemini": "./bin/claude-gemini",
    "claude-openrouter": "./bin/claude-openrouter",
    "claude-nvidia": "./bin/claude-nvidia",
    "claude-proxy": "./bin/claude-proxy",
    "proxy-run": "./bin/proxy-run"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "proxy": "bash bin/claude-proxy",
    "test": "node --test tests/*.test.mjs",
    "models": "node src/cli.mjs models",
    "doctor": "node src/cli.mjs doctor",
    "docs": "bash scripts/fetch-docs.sh",
    "proxy:run": "bash bin/proxy-run",
    "urls": "node src/cli.mjs urls"
  },
  "dependencies": {},
  "devDependencies": {}
}
