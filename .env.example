# appProxy — ortam şablonu
#
#   cp .env.example .env && nano .env
#
# KURALLAR
#  - `.env` asla git'e eklenmez (.gitignore) ve asla loglara/ekrana yazılmaz.
#  - Anahtarlar koda gömülmez; yalnızca bu dosyadan okunur.
#  - Bu dosya şablondur; gerçek anahtar buraya yazılmaz.

# ---- Sağlayıcı anahtarları -------------------------------------------------
# Google Gemini  (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenRouter     (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# NVIDIA hosted NIM — build.nvidia.com (nvapi-... ile başlar)

# ---- NVIDIA çalışma modu ---------------------------------------------------
# hosted : https://integrate.api.nvidia.com/v1  (OpenAI uyumlu; Anthropic endpoint YOK)
# nim    : self-hosted NIM konteyneri           (Anthropic uyumlu /v1/messages VAR)
NVIDIA_MODE=hosted
NIM_BASE_URL=http://127.0.0.1:8000
NIM_API_KEY=not-used

# ---- Yerel proxy sunucusu --------------------------------------------------
PROXY_HOST=127.0.0.1
PROXY_PORT=8790
# Claude Code'un proxy'ye sunacağı yerel kimlik (loopback; gerçek anahtar DEĞİL).
PROXY_TOKEN=appproxy-local-dev

# Refuseless   (https://api.refuseless.com)
REFUSELESS_API_KEY=

# Gövde loglama (varsayılan 0 → prompt içeriği loglanmaz)
PROXY_LOG_BODIES=0

# ---- Varsayilan saglayici ---------------------------------------------------
DEFAULT_PROVIDER=openrouter

# cohere (https://api.cohere.com)
CO_API_KEY=

# apinex (https://api.apinex.bond/v1)
APINEX_API_KEY=
