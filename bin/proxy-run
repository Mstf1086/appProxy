#!/usr/bin/env bash
# proxy-run — provider seç, provider'ın TÜM modellerini listele, model seç,
# istemci (Claude Code / Cline CLI / Pi CLI) seç ve seçime göre başlat.
#
# Kullanım:
#   proxy-run                              # interaktif: provider -> model -> istemci
#   proxy-run <provider>                   # provider sabit, model + istemci interaktif
#   proxy-run <provider> <model>           # model sabit, istemci interaktif
#   proxy-run <provider> <model> --client cline   # proxy + Cline CLI
#   proxy-run <provider> <model> --client claude  # soru sormadan Claude Code'u başlat
#   proxy-run <provider> <model> --client none   # sadece proxy'yi başlat
#   proxy-run <provider> <model> --client pi     # proxy + Pi CLI'ı (https://pi.dev) başlat
#   proxy-run <isim>                       # ÇALIŞAN proxy'ye yeniden bağlan (istemci seç)
#   proxy-run attach <isim> [--client claude]     # aynısı, açık yazım
#   proxy-run <provider> --list            # sadece modelleri listele
#   proxy-run <provider> --filter kimi     # model listesini filtrele
#   proxy-run --foreground <provider> <model>
#   proxy-run status                          # çalışan proxy'leri proje bilgisiyle listele
#   proxy-run stop                            # bu projeden başlatılanları durdur
#   proxy-run stop <isim> [--force]           # tek örnek (başka projedense --force)
#   proxy-run stop all                        # bu kurulumun tüm örnekleri
#   proxy-run models [provider]
#
# OpenAI-uyumlu endpoint: http://127.0.0.1:8790/<provider>/v1/chat/completions
# Anthropic endpoint    : http://127.0.0.1:8790/<provider>/v1/messages
#
# Pi CLI ile bağlanırken proxy bir ara yüz değildir; proxy arka planda çalışır
# ve Pi CLI seçtiğiniz modelin kendisine doğrudan bağlanır.
#
# Çalışan bir proxy varken proxy-run yeniden çalıştırılırsa önceki proxy'nin
# kapatılıp kapatılmayacağı sorulur: "açık kalsın" seçilirse yeni proxy'ye bir
# isim verilir ve boş bir portta açılır (run/instances/<isim>/ ile izlenir;
# durdurmak için: proxy-run stop <isim> ya da proxy-run stop all).
#
# Her örnek başlatıldığı proje diziniyle kaydedilir: `proxy-run stop` yalnızca
# bu projenin proxy'lerini durdurur, başka projelerinki etkilenmez.
#
# Yeniden bağlanma: proxy arka planda çalışmaya devam ettiği için istemciden
# (/exit) çıktıktan sonra `proxy-run <isim>` ile aynı proxy'ye dönülür. Bu
# çağrı YENİ proxy başlatmaz, provider/model sormaz; yalnızca istemci seçtirir
# (claude / pi / istemci yok) ve kayıtlı port ile modele bağlanır.
# İlk argüman hem bir provider hem bir örnek adıysa provider kazanır
# (geriye dönük uyumluluk); örnek adına açıkça bağlanmak için `attach` kullanın.
set -euo pipefail

ORIG_PWD="$PWD"
cd "$(dirname "$0")/.."

RUN_DIR="run"
PID_FILE="$RUN_DIR/proxy-run.pid"
PROVIDER_FILE="$RUN_DIR/proxy-run.provider"
MODEL_FILE="$RUN_DIR/proxy-run.model"
HOST_FILE="$RUN_DIR/proxy-run.host"
PORT_FILE="$RUN_DIR/proxy-run.port"
PROJECT_FILE="$RUN_DIR/proxy-run.project"  # proxy-run hangi dizinden çağrıldı
OUT_FILE="logs/proxy-run.out"
ROOT_DIR="$(pwd)"                          # betik repo köküne cd ettikten sonra
LOG_FILE="$ROOT_DIR/logs/proxy-run.log"    # okunabilir olay günlüğü (mutlak yol: istemci cd etse de bozulmaz)
INSTANCES_DIR="$RUN_DIR/instances"

# "Proje" = proxy-run'ın çağrıldığı dizin (ORIG_PWD), repo kökü DEĞİL.
# Birden çok proje aynı appProxy kurulumunu paylaşabildiği için süreç dizini
# her zaman repo kökünü gösterir; örnekleri birbirinden ayıran bilgi budur.
# `stop` varsayılan olarak yalnızca bu dizinden başlatılanları durdurur.
PROJECT_DIR="$(cd "$ORIG_PWD" 2>/dev/null && pwd -P || printf '%s' "$ORIG_PWD")"
mkdir -p "$RUN_DIR" "$INSTANCES_DIR" logs

# shellcheck source=bin/claude-env.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/claude-env.sh"

rlog() {  # proxy-run adımlarını .log dosyasına yaz (hata verirse sessiz geç)
  mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
  { printf '%s INFO  proxy-run %s\n' "$(date -u +%Y-%m-%dT%H:%M:%S.000Z)" "$*" >> "$LOG_FILE"; } 2>/dev/null || true
}

node_cfg() {
  node --input-type=module -e "$1"
}

usage() {
  cat <<'USAGE'
proxy-run — appProxy'yi provider/model seçerek başlatır ve istenirse istemciyi açar.

Kullanım:
  proxy-run                                     interaktif provider + model + istemci seçimi
  proxy-run <provider>                          provider sabit, model + istemci interaktif
  proxy-run <provider> <model>                  model sabit, istemci interaktif
  proxy-run <provider> <model> --client cline   proxy + Cline CLI'ı başlat
  proxy-run <provider> <model> --client claude  proxy + Claude Code'u başlat
  proxy-run <provider> <model> --client none   sadece proxy'yi başlat
  proxy-run <isim>                              ÇALIŞAN proxy'ye yeniden bağlan
  proxy-run attach <isim> [--client claude]     aynısı (açık yazım)
  proxy-run <provider> --list                   sadece modelleri listele
  proxy-run <provider> --filter <metin>         model listesini filtrele
  proxy-run --foreground <provider> <model>     proxy'yi ön planda çalıştır
  proxy-run add                                  yeni provider ekleme sihirbazı
  proxy-run remove [provider]                     provider'ı config'den kaldır (onay ister)
  proxy-run models [provider]                   modelleri listele (proxy başlatmadan)
  proxy-run status                              çalışan proxy'leri proje bilgisiyle listele
  proxy-run stop                                bu projeden başlatılan proxy'leri durdur
  proxy-run stop <isim> [--force]               yalnızca o örneği durdur
  proxy-run stop all                            bu kurulumun izlediği tüm örnekleri durdur

Provider menüsünde "+ yeni provider ekle" seçeneği de vardır; sihirbaz bitince
akış yeni provider ile devam eder (model listesi -> istemci seçimi -> başlat).

"Proje" = proxy-run'ın çağrıldığı dizin (repo kökü değil). Aynı appProxy
kurulumu birden çok projeden kullanılabildiği için her örnek, başlatıldığı
proje diziniyle birlikte kaydedilir:
  - `proxy-run stop` yalnızca bu projenin proxy'lerini durdurur; diğer
    projelerin proxy'leri çalışmaya devam eder,
  - `proxy-run stop <isim>` başka bir projeye aitse --force olmadan reddeder,
  - `proxy-run stop all` bu kurulumun izlediği tüm örnekleri durdurur.
`proxy-run status` her örnek için Proje ve Dizin satırlarını yazar.

Çalışan bir proxy varken yeni bir proxy-run başlatıldığında:
  - "Kapat" seçilirse önceki örnek(ler) durur ve aynı port yeniden kullanılır,
  - "Açık kalsın" seçilirse yeni proxy'ye bir isim verilir ve boş bir portta
    açılır (örnekler: proxy-run status / proxy-run stop <isim> / stop all).

Yeniden bağlanma (istemciden çıktıktan sonra):
  proxy-run <isim>              çalışan proxy'ye döner; yalnızca istemci sorulur
  proxy-run attach <isim>       aynısı, isim bir provider ile çakışıyorsa bunu kullanın
  proxy-run <isim> --client claude   soru sormadan doğrudan Claude Code
  proxy-run <isim> --client cline    aynı proxy'yi Cline CLI ile aç
  Var olan proxy kullanılır: yeni süreç başlatılmaz, port/model kayıttan okunur.
  Proxy kapalıysa hata verir; yeniden başlatmak için proxy-run <provider> <model>.

Seçenekler:
  -c, --client <cline|claude|pi|none>  Model seçiminden sonra başlatılacak istemci
  -f, --foreground                     Ön planda çalıştır (istemci seçimi yapılmaz)
  -l, --list                           Model listesini yazdır ve çık
      --filter <metin>                 Model listesini büyük/küçük harf duyarsız filtrele
      --host <host>                    PROXY_HOST değerini geçici olarak değiştir
      --port <port>                    PROXY_PORT değerini geçici olarak değiştir
  -h, --help                           Bu yardımı göster

--client pi: seçilen provider/model ile Pi CLI'ı (https://pi.dev) başlatır.
  Proxy arka planda çalışmaya devam eder; Pi doğrudan sağlayıcının ucuna bağlanır.
  Pi'nin yerleşik desteklemediği sağlayıcılar (cohere, refuseless, apinex,
  ...) için ~/.pi/agent/models.json'a otomatik "managedBy: appProxy" işaretli
  özel provider tanımı yazılır; appProxy .env'sindeki anahtar Pi'ye aktarılır.
USAGE
}

# --- Örnek (instance) yönetimi ----------------------------------------------
# Varsayılan (isimsiz) örnek run/proxy-run.* düz dosyalarıyla izlenir; "isimli"
# örnekler run/instances/<isim>/ altında aynı alanları (pid, provider, model,
# host, port) tutar. Böylece birden çok proxy yan yana çalışabilir.

# Komut satırı gerçekten appProxy sunucusu mu? Yalnızca "src/server.mjs" geçmesi
# yetmez: `grep src/server.mjs`, editör ya da kabuk komutu da eşleşir ve
# status'ta hayalet "[izlenmeyen]" satırları üretir. İlk token node olmalı.
# $1: boşlukla ayrılmış komut satırı
cmdline_is_proxy() {
  local cmd="${1:-}" first
  [[ -n "$cmd" ]] || return 1
  first="${cmd%% *}"
  [[ "$(basename "$first")" == node* ]] || return 1
  [[ "$cmd" == *"src/server.mjs"* ]]
}

is_proxy_pid() {
  [[ -n "${1:-}" ]] || return 1
  kill -0 "$1" 2>/dev/null || return 1
  [[ -r "/proc/$1/cmdline" ]] || return 1
  cmdline_is_proxy "$(tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null || true)"
}

kill_pid() {
  kill "$1" 2>/dev/null || true
  for _ in {1..30}; do
    kill -0 "$1" 2>/dev/null || return 0
    sleep 0.1
  done
  kill -9 "$1" 2>/dev/null || true
}

# Varsayılan (isimsiz) örneğin kayıt dosyaları.
clear_default_files() {
  rm -f "$PID_FILE" "$PROVIDER_FILE" "$MODEL_FILE" "$HOST_FILE" "$PORT_FILE" "$PROJECT_FILE"
}

# Bir örneğin başlatıldığı proje dizini. Eski kayıtlarda alan yoktur; boş
# dönerse çağıran taraf "bilinmiyor" olarak gösterir.
# $1: örnek ismi ("" = varsayılan)
instance_project() {
  local name="${1:-}" file val=""
  if [[ -n "$name" ]]; then
    file="$INSTANCES_DIR/$name/project"
  else
    file="$PROJECT_FILE"
  fi
  [[ -f "$file" ]] && val="$(cat "$file" 2>/dev/null || true)"
  printf '%s' "$val"
}

# Çalışan örnekleri listeler. Her satır:
#   isim \t pid \t host \t port \t provider \t model \t proje
# proje = proxy-run'ın çağrıldığı dizin ("" = eski kayıt, bilinmiyor).
# Ölü pid kayıtları temizlenir. Boş çıktı = çalışan örnek yok.
list_running_instances() {
  local name pid host port provider model project out=""
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  if [[ -n "$pid" ]]; then
    if ! kill -0 "$pid" 2>/dev/null; then
      clear_default_files
    elif ! is_proxy_pid "$pid"; then
      echo "UYARI: $PID_FILE'deki pid $pid appProxy (src/server.mjs) değil; yok sayıldı." >&2
    else
      host="$(cat "$HOST_FILE" 2>/dev/null || echo 127.0.0.1)"
      port="$(cat "$PORT_FILE" 2>/dev/null || echo '?')"
      provider="$(cat "$PROVIDER_FILE" 2>/dev/null || echo '?')"
      model="$(cat "$MODEL_FILE" 2>/dev/null || echo '?')"
      project="$(instance_project "")"
      out+="default"$'\t'"$pid"$'\t'"$host"$'\t'"$port"$'\t'"$provider"$'\t'"$model"$'\t'"$project"$'\n'
    fi
  fi
  local dir
  for dir in "$INSTANCES_DIR"/*/; do
    [[ -d "$dir" ]] || continue
    name="$(basename "$dir")"
    pid="$(cat "$dir/pid" 2>/dev/null || true)"
    if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then
      rm -rf "$dir"
      continue
    fi
    if ! is_proxy_pid "$pid"; then
      echo "UYARI: '$name' örnek pid'si ($pid) appProxy (src/server.mjs) değil; yok sayıldı." >&2
      continue
    fi
    host="$(cat "$dir/host" 2>/dev/null || echo 127.0.0.1)"
    port="$(cat "$dir/port" 2>/dev/null || echo '?')"
    provider="$(cat "$dir/provider" 2>/dev/null || echo '?')"
    model="$(cat "$dir/model" 2>/dev/null || echo '?')"
    project="$(instance_project "$name")"
    out+="$name"$'\t'"$pid"$'\t'"$host"$'\t'"$port"$'\t'"$provider"$'\t'"$model"$'\t'"$project"$'\n'
  done
  printf '%s' "$out"
}

# $1: örnek ismi ("" = varsayılan), $2: "1" ise proje korumasını atla
stop_instance() {
  local name="${1:-}" force="${2:-0}" pid_file pid_dir pid project label
  if [[ -n "$name" ]]; then
    pid_file="$INSTANCES_DIR/$name/pid"
    pid_dir="$INSTANCES_DIR/$name"
    label="$name"
  else
    pid_file="$PID_FILE"
    pid_dir=""
    label="default (isimsiz)"
  fi
  if [[ ! -f "$pid_file" ]]; then
    if [[ -n "$name" ]]; then
      echo "İsimli proxy '$name' çalışmıyor."
    else
      echo "Çalışan proxy yok ($PID_FILE bulunamadı)."
    fi
    return 0
  fi
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then
    echo "PID ${pid:-?} çalışmıyor; dosyalar temizlendi."
    if [[ -n "$pid_dir" ]]; then rm -rf "$pid_dir"; else clear_default_files; fi
    return 0
  fi
  if ! is_proxy_pid "$pid"; then
    echo "PID $pid appProxy (src/server.mjs) değil; dokunulmadı." >&2
    return 1
  fi
  # Proje koruması: başka bir projeden başlatılan proxy'yi yanlışlıkla
  # durdurmak, o projenin Claude Code oturumunu ortada bırakır.
  project="$(instance_project "$name")"
  if [[ "$force" != "1" && -n "$project" && "$project" != "$PROJECT_DIR" ]]; then
    echo "HATA: '$label' başka bir projeden başlatılmış: $project" >&2
    echo "      Bu proje: $PROJECT_DIR" >&2
    echo "      Yine de durdurmak için: bin/proxy-run stop ${name:-default} --force" >&2
    return 1
  fi
  kill_pid "$pid"
  if [[ -n "$pid_dir" ]]; then rm -rf "$pid_dir"; else clear_default_files; fi
  echo "Proxy durduruldu (pid $pid, isim: $label)."
  return 0
}

# Örnekleri toplu durdurur.
#   $1=project → yalnızca bu projeden (PROJECT_DIR) başlatılanlar
#   $1=all     → bu kurulumun izlediği tüm örnekler (proje ayrımı yok)
stop_instances() {
  local scope="${1:-project}" stopped=0 skipped=0 unknown=0
  local name pid host port provider model project
  while IFS=$'\t' read -r name pid host port provider model project; do
    [[ -n "$name" ]] || continue
    if [[ "$scope" != "all" ]]; then
      if [[ -z "$project" ]]; then
        # Eski kayıt (proje alanı yok): hangi projeye ait olduğu bilinmiyor,
        # yanlışlıkla başka projenin proxy'sini öldürmemek için dokunulmaz.
        unknown=$((unknown + 1))
        continue
      fi
      if [[ "$project" != "$PROJECT_DIR" ]]; then
        skipped=$((skipped + 1))
        continue
      fi
    fi
    if [[ "$name" == "default" ]]; then
      stop_instance "" 1
    else
      stop_instance "$name" 1
    fi
    stopped=$((stopped + 1))
  done < <(list_running_instances)
  if [[ "$stopped" -eq 0 ]]; then
    if [[ "$skipped" -gt 0 || "$unknown" -gt 0 ]]; then
      echo "Bu projeden ($PROJECT_DIR) başlatılmış çalışan proxy yok."
    else
      echo "Çalışan proxy yok."
    fi
  fi
  if [[ "$skipped" -gt 0 ]]; then
    echo "Not: başka projelerden başlatılmış $skipped proxy'ye dokunulmadı."
    echo "     Hepsini görmek için: bin/proxy-run status"
    echo "     Hepsini durdurmak için: bin/proxy-run stop all"
  fi
  if [[ "$unknown" -gt 0 ]]; then
    echo "Not: $unknown proxy'nin proje kaydı yok (eski sürümle başlatılmış)."
    echo "     Tek tek durdurmak için: bin/proxy-run stop <isim>"
  fi
  return 0
}

# Çalışan bir örneğin kayıt satırını döndürür (yoksa boş + çıkış kodu 1).
# $1: örnek ismi ("default" = isimsiz varsayılan)
running_instance_row() {
  local want="${1:-default}" name pid host port provider model project
  while IFS=$'\t' read -r name pid host port provider model project; do
    [[ -n "$name" ]] || continue
    [[ "$name" == "$want" ]] || continue
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$pid" "$host" "$port" "$provider" "$model" "$project"
    return 0
  done < <(list_running_instances)
  return 1
}

# Çalışan örneklerden birini seçtirir; tek örnek varsa doğrudan onu döndürür.
# `select` menüsü stderr'e yazılır, bu yüzden stdout yalnızca isim taşır.
pick_running_instance() {
  local -a names=()
  local n rest choice=""
  while IFS=$'\t' read -r n rest; do
    [[ -n "$n" ]] && names+=("$n")
  done < <(list_running_instances)
  if [[ ${#names[@]} -eq 0 ]]; then
    return 1
  fi
  if [[ ${#names[@]} -eq 1 ]]; then
    printf '%s' "${names[0]}"
    return 0
  fi
  echo "Hangi proxy'ye bağlanılsın?" >&2
  select choice in "${names[@]}"; do
    [[ -n "$choice" ]] && break
  done
  [[ -n "$choice" ]] || return 1
  printf '%s' "$choice"
}

# Claude Code'u verilen taban URL ile başlatır ve çıkış kodunu döndürür.
# $1: Anthropic taban URL (/v1 İÇERMEZ), $2: model, $3: hızlı model
run_claude_client() {
  local base="$1" model="$2" fast="$3" ctx rc=0
  export DEFAULT_PROVIDER="$PROVIDER"
  # Takma adları (haiku/sonnet/opus/alt ajan) seçilen modele yönlendir (NVIDIA NIM kılavuzu).
  ctx="$(node src/context-window.mjs "$PROVIDER" "$model" 2>/dev/null || echo 200000)"
  apply_claude_env "$base" "$TOKEN_ARG" "$model" "$fast" "$ctx"
  rlog "claude env model=$ANTHROPIC_MODEL haiku=$ANTHROPIC_DEFAULT_HAIKU_MODEL sonnet=$ANTHROPIC_DEFAULT_SONNET_MODEL opus=$ANTHROPIC_DEFAULT_OPUS_MODEL subagent=$CLAUDE_CODE_SUBAGENT_MODEL context=$CLAUDE_CODE_MAX_CONTEXT_TOKENS"
  cd "$ORIG_PWD"
  claude || rc=$?
  rlog "client exit claude code=$rc"
  return "$rc"
}

# Cline CLI'ı proxy'ye yönlendirip etkileşimli oturumu başlatır.
# $1: OpenAI taban URL (…/<provider>/v1), $2: model
#
# Cline'ın `openai-compatible` sağlayıcısı baseUrl'i ~/.cline altında saklar;
# port/örnek her oturumda değişebildiği için `auth` her seferinde yeniden
# yazılır. Cline akış (stream) bekler: proxy SSE döndürmezse "Response stream
# ended without a finish reason" hatası verir.
run_cline_client() {
  local base="$1" model="$2" rc=0
  rlog "cline auth base=$base model=$model"
  if ! cline auth openai-compatible -k "$TOKEN_ARG" -m "$model" -b "$base"; then
    echo "HATA: Cline yapılandırılamadı (cline auth)." >&2
    return 1
  fi
  cd "$ORIG_PWD"
  cline -P openai-compatible -m "$model" || rc=$?
  rlog "client exit cline code=$rc"
  return "$rc"
}

# Çalışan bir örneğe YENİDEN BAĞLANIR: yeni proxy başlatmaz, provider/model
# sormaz; kayıtlı port ve modelle istemciyi açar. İstemciden /exit ile çıkıp
# aynı proxy'ye dönmek için kullanılır.
# $1: örnek ismi ("default" = isimsiz), $2: istemci (claude|pi|none|"")
attach_instance() {
  local name="${1:-default}" want_client="${2:-}"
  local row r_name r_pid r_host r_port r_provider r_model r_project label

  row="$(running_instance_row "$name" || true)"
  if [[ -z "$row" ]]; then
    echo "HATA: '$name' adlı çalışan proxy yok." >&2
    echo "  Çalışan örnekler : bin/proxy-run status" >&2
    echo "  Yeni proxy       : bin/proxy-run <provider> <model>" >&2
    return 1
  fi
  IFS=$'\t' read -r r_name r_pid r_host r_port r_provider r_model r_project <<< "$row"
  [[ "$r_host" == "0.0.0.0" || "$r_host" == "::" ]] && r_host="127.0.0.1"
  label="$r_name"
  [[ "$r_name" == "default" ]] && label="default (isimsiz)"

  # Kayıt var ama süreç yanıt vermiyorsa istemciyi boşuna açmayalım.
  if ! curl -sf --max-time 3 "http://$r_host:$r_port/health" >/dev/null 2>&1; then
    echo "HATA: '$label' kayıtlı ama http://$r_host:$r_port/health yanıt vermiyor." >&2
    echo "  Logları görün : tail -n 30 logs/proxy-run-${r_name}.log" >&2
    echo "  Durdurup açın : bin/proxy-run stop $r_name && bin/proxy-run $r_provider $r_model" >&2
    return 1
  fi

  # Kayıttan gelen provider/model ile istemci ortamını kur.
  PROVIDER="$r_provider"
  MODEL="$r_model"
  local cfg_token="" cfg_fast="" cfg_key_set="no" cfg_key_env=""
  readarray -t ACFG < <(node_cfg "
import { loadConfig } from './src/config.mjs';
const cfg = loadConfig();
const p = cfg.active('$r_provider');
console.log(cfg.proxyToken || '');
console.log(p?.fastModel ?? '');
console.log(cfg.apiKeyOf(p) ? 'yes' : 'no');
console.log(p?.apiKeyEnv ?? '');
" 2>/dev/null || true)
  if [[ ${#ACFG[@]} -ge 4 ]]; then
    cfg_token="${ACFG[0]}"; cfg_fast="${ACFG[1]}"; cfg_key_set="${ACFG[2]}"; cfg_key_env="${ACFG[3]}"
  else
    echo "UYARI: config okunamadı; proxy token'ı ve hızlı model bilinmiyor." >&2
  fi
  FAST_MODEL="$cfg_fast"
  TOKEN_ARG="${cfg_token:-appproxy-local-dev}"
  ANTHROPIC_BASE="http://$r_host:$r_port/$r_provider"
  OPENAI_BASE="http://$r_host:$r_port/$r_provider/v1"
  SERVER_URL="http://$r_host:$r_port"

  echo
  echo "=========================================================="
  echo " Çalışan proxy'ye bağlanılıyor"
  echo "=========================================================="
  echo "  Örnek    : $label  (pid $r_pid)"
  [[ -n "$r_project" ]] && echo "  Proje    : $r_project"
  echo "  Provider : $r_provider"
  echo "  Model    : $r_model"
  echo "  Proxy    : $SERVER_URL"

  if [[ -z "$want_client" ]]; then
    # Menüden gelindiyse stdin zaten seçim için kullanılıyor (boru olabilir);
    # yalnızca doğrudan `proxy-run <isim>` çağrısında terminal aranır.
    if [[ ! -t 0 && "${INTERACTIVE:-0}" != "1" ]]; then
      echo "HATA: istemci seçimi için terminal gerekli (stdin terminal değil)." >&2
      echo "  Doğrudan seçmek için: bin/proxy-run $r_name --client cline|claude|pi|none" >&2
      return 1
    fi
    echo
    echo "İstemci seçimi:"
    local word
    select word in cline claude "pi cli (https://pi.dev)" "sadece bağlan (istemci açma)"; do
      [[ -n "$word" ]] && break
    done
    case "${word:-}" in
      cline)  want_client="cline" ;;
      claude) want_client="claude" ;;
      pi*)    want_client="pi" ;;
      *)      want_client="none" ;;
    esac
  fi

  case "$want_client" in
    cline)
      if ! command -v cline >/dev/null 2>&1; then
        echo "UYARI: 'cline' bulunamadı (npm i -g cline); istemci açılmadı." >&2
        want_client="none"
      fi
      ;;
    claude)
      if ! command -v claude >/dev/null 2>&1; then
        echo "UYARI: 'claude' bulunamadı; istemci açılmadı." >&2
        want_client="none"
      fi
      ;;
    pi)
      if ! command -v pi >/dev/null 2>&1; then
        echo "UYARI: 'pi' (Pi Coding Agent, https://pi.dev) bulunamadı; istemci açılmadı." >&2
        want_client="none"
      fi
      ;;
  esac

  rlog "attach instance=$r_name pid=$r_pid provider=$r_provider model=$r_model client=$want_client project=$r_project"

  local rc=0
  case "$want_client" in
    cline)
      echo
      echo "Cline CLI başlıyor (çıkmak için Ctrl+C). Proxy arkada çalışmaya devam eder."
      run_cline_client "$OPENAI_BASE" "$MODEL" || rc=$?
      ;;
    claude)
      echo
      echo "Claude Code başlıyor (çıkmak için /exit). Proxy arkada çalışmaya devam eder."
      run_claude_client "$ANTHROPIC_BASE" "$MODEL" "$FAST_MODEL" || rc=$?
      ;;
    pi)
      echo
      echo "Pi CLI (https://pi.dev) başlatılıyor (çıkmak için /exit)."
      if ! node src/providers/pi.mjs "$PROVIDER" "$MODEL" "$ORIG_PWD"; then
        echo "UYARI: Pi CLI başlatılamadı; proxy çalışmaya devam ediyor." >&2
        rc=1
      fi
      ;;
    *)
      echo
      echo "İstemci açılmadı. Proxy çalışıyor: $SERVER_URL"
      echo "  OpenAI   : $OPENAI_BASE"
      echo "  Anthropic: $ANTHROPIC_BASE"
      ;;
  esac

  if [[ "$want_client" != "none" ]]; then
    echo
    echo "İstemci kapandı (kod $rc). Proxy çalışmaya devam ediyor (pid $r_pid)."
    echo "Tekrar bağlanmak için: bin/proxy-run $r_name"
  fi
  return "$rc"
}

port_busy() {  # $1: port — o portta bir TCP dinleyici var mı?
  (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}

find_free_port() {  # $1: başlangıç port; ilk boş portu yazdırır
  local p=$(( $1 + 1 ))
  while (( p <= $1 + 200 )); do
    if ! port_busy "$p"; then
      echo "$p"
      return 0
    fi
    p=$((p + 1))
  done
  return 1
}

valid_instance_name() {
  [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$ ]] || return 1
  [[ "$1" == "default" ]] && return 1
  [[ "$1" == "all" ]] && return 1
  return 0
}

suggest_instance_name() {
  local n=2
  while [[ -d "$INSTANCES_DIR/proxy$n" ]]; do
    n=$((n + 1))
  done
  echo "proxy$n"
}

# Çalışan bir sürecin çalışma dizinini bulur (Linux /proc, macOS lsof, pwdx).
# proxy-run repo köküne cd ettikten sonra node'u başlattığı için bu dizin aynı
# zamanda "proxy hangi kurulumdan çalışıyor" sorusunun cevabıdır.
process_cwd() {
  local pid="${1:-}" dir=""
  [[ -n "$pid" ]] || return 0
  if [[ -L "/proc/$pid/cwd" ]]; then
    dir="$(readlink -f "/proc/$pid/cwd" 2>/dev/null || true)"
  fi
  if [[ -z "$dir" ]] && command -v lsof >/dev/null 2>&1; then
    dir="$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1)"
  fi
  if [[ -z "$dir" ]] && command -v pwdx >/dev/null 2>&1; then
    dir="$(pwdx "$pid" 2>/dev/null | sed 's/^[0-9]*: *//')"
  fi
  printf '%s' "$dir"
}

# Bir pid'in hâlâ appProxy (src/server.mjs) olup olmadığını doğrular.
process_is_proxy() {
  local pid="${1:-}" cmd=""
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  if [[ -r "/proc/$pid/cmdline" ]]; then
    cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
  elif command -v ps >/dev/null 2>&1; then
    cmd="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  fi
  cmdline_is_proxy "$cmd"
}

# Bu kurulumun run/ kaydında olmayan appProxy süreçleri (başka bir checkout'tan
# başlatılmış olabilir). $1: boşlukla ayrılmış izlenen pid listesi.
untracked_proxy_pids() {
  local tracked=" ${1:-} " pid cmd
  if [[ -d /proc ]]; then
    for pid in /proc/[0-9]*; do
      pid="${pid#/proc/}"
      [[ "$tracked" == *" $pid "* ]] && continue
      cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
      cmdline_is_proxy "$cmd" && printf '%s\n' "$pid"
    done
  elif command -v ps >/dev/null 2>&1; then
    ps -axo pid=,command= 2>/dev/null | while read -r pid cmd; do
      [[ "$tracked" == *" $pid "* ]] && continue
      cmdline_is_proxy "$cmd" && printf '%s\n' "$pid"
    done
  fi
  return 0
}

status_proxy() {
  local running
  running="$(list_running_instances)"
  local name pid host port provider model project label health pdir tracked="" shown=0 scope
  if [[ -n "$running" ]]; then
    echo "Çalışan proxy örnekleri:"
    while IFS=$'\t' read -r name pid host port provider model project; do
      [[ -n "$name" ]] || continue
      label="$name"
      [[ "$name" == "default" ]] && label="default (isimsiz)"
      [[ "$host" == "0.0.0.0" || "$host" == "::" ]] && host="127.0.0.1"
      health="$(curl -sf --max-time 3 "http://$host:$port/health" 2>/dev/null || echo '(yanıt yok)')"
      pdir="$(process_cwd "$pid")"
      tracked+=" $pid"
      shown=1
      # Hangi projeden başlatıldığı başlıkta görünsün: `stop` yalnızca
      # "bu proje" olanları durdurur, karışıklık buradan çıkıyordu.
      scope=""
      if [[ -n "$project" && "$project" == "$PROJECT_DIR" ]]; then
        scope="  (bu proje)"
      elif [[ -n "$project" ]]; then
        scope="  (başka proje)"
      fi
      echo "  [$label] pid $pid$scope"
      # Proje: proxy-run'ın çağrıldığı dizin (süreç dizini değil).
      if [[ -n "$project" ]]; then
        echo "    Proje    : $project"
      else
        echo "    Proje    : bilinmiyor (eski kayıt; bu sürümle yeniden başlatın)"
      fi
      # Dizin: sunucunun gerçekten çalıştığı appProxy kurulumu. Projeyle aynıysa
      # tekrar yazmanın anlamı yok.
      if [[ -n "$pdir" && "$pdir" != "$project" ]]; then
        echo "    Dizin    : $pdir"
      elif [[ -z "$pdir" ]]; then
        echo "    Dizin    : bilinmiyor"
      fi
      echo "    Provider : $provider"
      echo "    Model    : $model"
      echo "    OpenAI   : http://$host:$port/$provider/v1"
      # Claude Code (Anthropic SDK) /v1/messages yolunu kendisi ekler; taban URL'de /v1 olmamalı.
      echo "    Anthropic: http://$host:$port/$provider"
      echo "    Health   : $health"
    done <<< "$running"
  fi

  # Bu kurulumun kaydı olmayan süreçler: genelde başka bir checkout'tan
  # başlatılmış proxy'lerdir, "status neden hiçbir şey göstermiyor" sorusunu yanıtlar.
  local orphan orphan_header=0
  for orphan in $(untracked_proxy_pids "$tracked"); do
    # Tarama ile yazdırma arasında süreç ölmüş olabilir (kısa ömürlü kabuklar).
    process_is_proxy "$orphan" || continue
    if [[ "$orphan_header" -eq 0 ]]; then
      if [[ "$shown" -eq 0 ]]; then
        echo "Çalışan proxy var ama bu kurulumda kaydı yok:"
      else
        echo "Bu kurulumda kaydı olmayan süreçler:"
      fi
      orphan_header=1
      shown=1
    fi
    echo "  [izlenmeyen] pid $orphan"
    # Kayıt olmadığı için proje bilinemez; süreç dizini tek ipucu.
    echo "    Proje    : bilinmiyor (kayıt yok)"
    echo "    Dizin    : $(process_cwd "$orphan")"
    echo "    Not      : başka bir appProxy kurulumundan başlatılmış; durdurmak için: kill $orphan"
  done

  if [[ "$shown" -eq 0 ]]; then
    echo "Proxy çalışmıyor."
    return 1
  fi
  return 0
}

FORCE_ATTACH=0   # `proxy-run attach <isim>`: isim provider ile çakışsa bile bağlan
INTERACTIVE=0    # menüden seçim yapıldıysa stdin terminal olmasa da soru sorulabilir

case "${1:-}" in
  attach|connect|baglan)
    # Açık yazım: `proxy-run attach pr3 [--client claude]`. Geri kalan argümanlar
    # aşağıdaki normal ayrıştırıcıya düşer (isim -> PROVIDER, istemci -> CLIENT).
    shift
    FORCE_ATTACH=1
    ;;
  stop)
    shift
    STOP_TARGET=""
    STOP_FORCE=0
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -h|--help)
          echo "Kullanım: bin/proxy-run stop [isim|all] [--force]"
          echo "  (isimsiz) bu projeden başlatılan tüm proxy'leri durdurur"
          echo "  all       bu kurulumun izlediği tüm proxy'leri durdurur (proje ayrımı yok)"
          echo "  isim      yalnızca o örneği durdurur; başka projedense --force gerekir"
          exit 0
          ;;
        --force|-f)
          STOP_FORCE=1
          ;;
        -*)
          echo "Bilinmeyen seçenek: $1" >&2
          exit 1
          ;;
        *)
          STOP_TARGET="$1"
          ;;
      esac
      shift
    done
    case "$STOP_TARGET" in
      "")
        # Varsayılan: yalnızca bu proje. Başka projelerin proxy'leri çalışmaya devam eder.
        stop_instances project
        ;;
      default)
        stop_instance "" "$STOP_FORCE"
        ;;
      all|--all)
        stop_instances all
        ;;
      *)
        stop_instance "$STOP_TARGET" "$STOP_FORCE"
        ;;
    esac
    exit $?
    ;;
  status)
    status_proxy
    exit $?
    ;;
  models)
    shift
    node src/cli.mjs models "${1:-}"
    exit 0
    ;;
  add)
    node src/cli.mjs add-provider
    exit $?
    ;;
  remove|rm)
    shift
    node src/cli.mjs remove-provider "${1:-}"
    exit $?
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
esac

FOREGROUND=0
LIST_ONLY=0
FILTER=""
PROVIDER=""
MODEL=""
HOST=""
PORT=""
PORT_EXPLICIT=0
CLIENT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -f|--foreground)
      FOREGROUND=1
      shift
      ;;
    -l|--list)
      LIST_ONLY=1
      shift
      ;;
    --filter)
      FILTER="${2:-}"
      shift 2
      ;;
    --filter=*)
      FILTER="${1#*=}"
      shift
      ;;
    --client|-c)
      CLIENT="${2:-}"
      shift 2
      ;;
    --client=*)
      CLIENT="${1#*=}"
      shift
      ;;
    -c*)
      CLIENT="${1#-c}"
      shift
      ;;
    --host)
      HOST="${2:-}"
      shift 2
      ;;
    --host=*)
      HOST="${1#*=}"
      shift
      ;;
    --port)
      PORT="${2:-}"
      PORT_EXPLICIT=1
      shift 2
      ;;
    --port=*)
      PORT="${1#*=}"
      PORT_EXPLICIT=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Bilinmeyen seçenek: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [[ -z "$PROVIDER" ]]; then
        PROVIDER="$1"
      elif [[ -z "$MODEL" ]]; then
        MODEL="$1"
      else
        echo "Fazla argüman: $1" >&2
        exit 1
      fi
      shift
      ;;
  esac
done

case "${CLIENT:-}" in
  ""|cline|claude|pi|none) ;;
  *)
    echo "HATA: --client yalnızca cline, claude, pi veya none olabilir (aldım: $CLIENT)" >&2
    exit 1
    ;;
esac

[[ -n "$HOST" ]] && export PROXY_HOST="$HOST"
[[ -n "$PORT" ]] && export PROXY_PORT="$PORT"

if [[ "$FOREGROUND" == "1" && -n "${CLIENT:-}" ]]; then
  echo "UYARI: --foreground ile --client birlikte kullanılamaz; istemci seçimi yok sayıldı." >&2
  CLIENT=""
fi

# Provider listesi erken yüklenir: `proxy-run <isim>` çağrısında ilk argümanın
# provider mı yoksa çalışan bir örnek adı mı olduğunu ayırt etmek için gerekir.
PROVIDERS="$(node_cfg "
import { loadConfig } from './src/config.mjs';
console.log(Object.keys(loadConfig().providers).join('\\n'));
" 2>/dev/null || true)"

# --- Mevcut örneğe yeniden bağlanma ----------------------------------------
# `proxy-run <isim>`: ilk argüman bilinen bir provider DEĞİL ama çalışan bir
# örneğin adıysa yeni proxy başlatılmaz; var olan proxy'ye istemci bağlanır.
# İkisi de eşleşirse provider kazanır (eski davranış); açık bağlanma için
# `proxy-run attach <isim>`.
if [[ "$LIST_ONLY" != "1" && -z "$MODEL" && -n "${PROVIDER:-}" && "$FORCE_ATTACH" != "1" ]]; then
  if running_instance_row "$PROVIDER" >/dev/null; then
    if [[ -z "$PROVIDERS" ]] || ! grep -qxF -- "$PROVIDER" <<< "$PROVIDERS"; then
      FORCE_ATTACH=1
    fi
  fi
fi

if [[ "$FORCE_ATTACH" == "1" ]]; then
  if [[ "$FOREGROUND" == "1" ]]; then
    echo "HATA: --foreground yeni bir proxy başlatır; mevcut örneğe bağlanmak için kullanılamaz." >&2
    echo "  Bağlanmak için: bin/proxy-run ${PROVIDER:-<isim>} --client claude" >&2
    exit 1
  fi
  if [[ -n "$HOST" || "$PORT_EXPLICIT" == "1" ]]; then
    echo "UYARI: --host/--port yok sayıldı; mevcut proxy'nin kayıtlı adresi kullanılıyor." >&2
  fi
  if [[ -z "${PROVIDER:-}" ]]; then
    # `proxy-run attach` (isimsiz): varsayılan (isimsiz) örneğe bağlan.
    attach_instance "default" "${CLIENT:-}"
  else
    attach_instance "$PROVIDER" "${CLIENT:-}"
  fi
  exit $?
fi

ADD_OPTION="+ yeni provider ekle"

load_providers() {
  PROVIDERS="$(node_cfg "
import { loadConfig } from './src/config.mjs';
console.log(Object.keys(loadConfig().providers).join('\n'));
")"
}

run_add_provider() {
  echo
  echo "Yeni provider ekleme sihirbazı (vazgeçmek için Ctrl+C):"
  local wizard_stdout newprov
  if ! wizard_stdout="$(node src/cli.mjs add-provider)"; then
    echo "Provider eklenmedi." >&2
    PROVIDER=""
    return 1
  fi
  newprov="$(grep -E '^ADDED_PROVIDER=' <<< "$wizard_stdout" | tail -n1 | cut -d= -f2-)"
  if [[ -z "$newprov" ]]; then
    echo "Provider eklenmedi." >&2
    PROVIDER=""
    return 1
  fi
  load_providers
  PROVIDER="$newprov"
  echo "Provider eklendi: $PROVIDER"
  return 0
}

if [[ -z "$PROVIDER" ]]; then
  # Çalışan proxy varsa provider menüsüne "mevcut proxy'ye bağlan" seçeneği
  # eklenir: istemciden (/exit) çıktıktan sonra isim hatırlamadan devam etmek için.
  ATTACH_OPTION=""
  if [[ -n "$(list_running_instances)" ]]; then
    ATTACH_OPTION="⟳ çalışan proxy'ye bağlan (yeni proxy başlatma)"
  fi
  echo "Provider seçimi:"
  INTERACTIVE=1
  if [[ -n "$ATTACH_OPTION" ]]; then
    select PROVIDER in $PROVIDERS "$ADD_OPTION" "$ATTACH_OPTION"; do
      [[ -n "$PROVIDER" ]] && break
    done
  else
    select PROVIDER in $PROVIDERS "$ADD_OPTION"; do
      [[ -n "$PROVIDER" ]] && break
    done
  fi
  if [[ -n "$ATTACH_OPTION" && "${PROVIDER:-}" == "$ATTACH_OPTION" ]]; then
    ATTACH_TARGET="$(pick_running_instance)" || {
      echo "Bağlanılacak çalışan proxy bulunamadı." >&2
      exit 1
    }
    attach_instance "$ATTACH_TARGET" "${CLIENT:-}"
    exit $?
  fi
  if [[ "${PROVIDER:-}" == "$ADD_OPTION" ]]; then
    PROVIDER=""
    run_add_provider || true
  fi
  if [[ -z "${PROVIDER:-}" ]]; then
    PROVIDER="$(head -n1 <<< "$PROVIDERS")"
    echo "Seçim yapılmadı, ilk provider kullanılacak: $PROVIDER" >&2
  fi
else
  if ! grep -qx "$PROVIDER" <<< "$PROVIDERS"; then
    echo "HATA: bilinmeyen provider: $PROVIDER" >&2
    # Sık karışan durum: örnek adı yazılmış ama örnek çalışmıyor (ya da kapalı).
    RUNNING_LIST="$(list_running_instances)"
    if [[ -n "$RUNNING_LIST" ]]; then
      echo "Çalışan proxy örnekleri (bunlara bağlanmak için: bin/proxy-run <isim>):" >&2
      while IFS=$'\t' read -r N_NAME N_PID N_HOST N_PORT N_PROVIDER N_MODEL N_PROJECT; do
        [[ -n "$N_NAME" ]] || continue
        printf '  %-14s pid=%-7s port=%-6s %s / %s\n' "$N_NAME" "$N_PID" "$N_PORT" "$N_PROVIDER" "$N_MODEL" >&2
      done <<< "$RUNNING_LIST"
    fi
    echo "Geçerli seçenekler: $(echo "$PROVIDERS" | tr '\n' ' ')" >&2
    echo "Yeni proxy başlatmak için: bin/proxy-run <provider> <model>" >&2
    exit 1
  fi
fi

echo
if [[ -n "$FILTER" ]]; then
  echo "Modeller getiriliyor ($PROVIDER, filtre: $FILTER)..."
else
  echo "Modeller getiriliyor ($PROVIDER)..."
fi
MODEL_LIST="$(node src/cli.mjs models "$PROVIDER" 2> >(sed 's/^/  /' >&2) || true)"
MODEL_LIST="$(printf '%s\n' "$MODEL_LIST" | sed '/^$/d')"

if [[ -n "$FILTER" ]]; then
  MODEL_LIST="$(grep -i -- "$FILTER" <<< "$MODEL_LIST" || true)"
fi

if [[ -z "$MODEL_LIST" ]]; then
  echo "UYARI: upstream model listesi alınamadı; config/models.json presetleri kullanılacak." >&2
  MODEL_LIST="$(node_cfg "
import { loadConfig } from './src/config.mjs';
const cfg = loadConfig();
const presets = cfg.models['$PROVIDER']?.presets ?? [];
for (const preset of presets) console.log(preset.id);
")"
  MODEL_LIST="$(printf '%s\n' "$MODEL_LIST" | sed '/^$/d')"
fi

if [[ -z "$MODEL_LIST" ]]; then
  echo "HATA: $PROVIDER için model bulunamadı." >&2
  exit 1
fi

if [[ "$LIST_ONLY" == "1" ]]; then
  echo
  echo "$MODEL_LIST"
  exit 0
fi

if [[ -z "$MODEL" ]]; then
  echo
  echo "Model seçimi ($PROVIDER):"
  select MODEL in $MODEL_LIST; do
    [[ -n "$MODEL" ]] && break
  done
  if [[ -z "${MODEL:-}" ]]; then
    MODEL="$(head -n1 <<< "$MODEL_LIST")"
    echo "Seçim yapılmadı, ilk model kullanılacak: $MODEL" >&2
  fi
else
  if ! grep -qxF -- "$MODEL" <<< "$MODEL_LIST"; then
    echo "UYARI: '$MODEL' listede yok; yine de denenecek (proxy model eşlemesi uygular)." >&2
  fi
fi

readarray -t CFG < <(node_cfg "
import { loadConfig } from './src/config.mjs';
const cfg = loadConfig();
const p = cfg.active('$PROVIDER');
console.log(cfg.server.host);
console.log(String(cfg.server.port));
console.log(cfg.proxyToken || '');
console.log(p?.defaultModel ?? '');
console.log(p?.fastModel ?? '');
console.log(cfg.apiKeyOf(p) ? 'yes' : 'no');
console.log(p?.apiKeyEnv ?? '');
")

if [[ ${#CFG[@]} -lt 7 ]]; then
  echo "HATA: config okunamadı." >&2
  exit 1
fi

CFG_HOST="${CFG[0]}"
CFG_PORT="${CFG[1]}"
PROXY_TOKEN="${CFG[2]}"
DEFAULT_MODEL="${CFG[3]}"
FAST_MODEL="${CFG[4]}"
KEY_SET="${CFG[5]}"
API_KEY_ENV="${CFG[6]}"

[[ -z "$MODEL" ]] && MODEL="$DEFAULT_MODEL"
TOKEN_ARG="${PROXY_TOKEN:-appproxy-local-dev}"

if [[ "$KEY_SET" != "yes" ]]; then
  echo "UYARI: $PROVIDER için API anahtarı boş görünüyor (.env). Upstream 401 dönebilir." >&2
fi

# --- Çalışan proxy kararı ---------------------------------------------------
# Daha önce başlatılmış ve kapatılmamış proxy(ler) varsa kullanıcıya sorulur:
# öncekiler kapatılıp aynı portta mı devam edilsin, yoksa öncekiler çalışmaya
# devam ederken yeni proxy'ye bir isim verilip boş bir portta mı açılsın?
INSTANCE_NAME=""          # boş = varsayılan (isimsiz) örnek
EFFECTIVE_PORT="$CFG_PORT"

if [[ "$FOREGROUND" != "1" ]]; then
  RUNNING_INSTANCES="$(list_running_instances)"
  if [[ -n "$RUNNING_INSTANCES" ]]; then
    echo
    echo "Çalışan proxy örnekleri:"
    while IFS=$'\t' read -r R_NAME R_PID R_HOST R_PORT R_PROVIDER R_MODEL R_PROJECT; do
      [[ -n "$R_NAME" ]] || continue
      R_LABEL="$R_NAME"
      [[ "$R_NAME" == "default" ]] && R_LABEL="(isimsiz varsayılan)"
      [[ "$R_HOST" == "0.0.0.0" || "$R_HOST" == "::" ]] && R_HOST="127.0.0.1"
      R_SCOPE=""
      [[ "$R_PROJECT" == "$PROJECT_DIR" ]] && R_SCOPE=" [bu proje]"
      printf '  %-22s pid=%-7s http://%s:%-6s %-14s %s%s\n' \
        "$R_LABEL" "$R_PID" "$R_HOST" "$R_PORT" "$R_PROVIDER" "$R_MODEL" "$R_SCOPE"
      if [[ -n "$R_PROJECT" && "$R_PROJECT" != "$PROJECT_DIR" ]]; then
        printf '  %-22s proje: %s\n' "" "$R_PROJECT"
      fi
    done <<< "$RUNNING_INSTANCES"

    if [[ ! -t 0 ]]; then
      echo "HATA: çalışan proxy var; terminalden seçim yapılamıyor (stdin terminal değil)." >&2
      echo "  Bu projenin proxy'lerini kapatmak için: bin/proxy-run stop" >&2
      echo "  Tüm projelerinkini kapatmak için      : bin/proxy-run stop all" >&2
      echo "  Yan yana çalıştırmak için: bin/proxy-run <provider> <model> --port <port> --client none" >&2
      exit 1
    fi

    echo
    echo "Yeni bir proxy başlatılacak. Önceki proxy ne yapılsın?"
    select DECISION_WORD in \
      "Kapat: bu projenin önceki proxy'lerini durdur, aynı portta başlat" \
      "Açık kalsın: yeni proxy'ye isim ver, başka portta aç" \
      "İptal"; do
      [[ -n "$DECISION_WORD" ]] && break
    done
    if [[ -z "${DECISION_WORD:-}" ]]; then
      echo "Seçim yapılmadı; iptal edildi." >&2
      exit 1
    fi
    case "$DECISION_WORD" in
      Kapat*)
        echo "Bu projenin önceki proxy örnekleri durduruluyor..."
        # Yalnızca bu proje: başka projelerin proxy'leri çalışmaya devam eder.
        stop_instances project
        # Başka bir proje aynı portu tutuyorsa yeni süreç EADDRINUSE ile ölür;
        # sessizce başarısız olmak yerine boş bir porta geç.
        if port_busy "$EFFECTIVE_PORT"; then
          if [[ "$PORT_EXPLICIT" == "1" ]]; then
            echo "HATA: --port $EFFECTIVE_PORT başka bir projenin proxy'si tarafından kullanılıyor." >&2
            echo "      Boş bir port belirtin ya da: bin/proxy-run stop all" >&2
            exit 1
          fi
          if NEXT_PORT="$(find_free_port "$EFFECTIVE_PORT")"; then
            echo "UYARI: $EFFECTIVE_PORT başka bir projenin proxy'sinde; port $NEXT_PORT kullanılacak." >&2
            EFFECTIVE_PORT="$NEXT_PORT"
          fi
        fi
        ;;
      Açık*)
        NAME_SUGGEST="$(suggest_instance_name)"
        read -r -p "Yeni proxy'nin ismi [$NAME_SUGGEST]: " NAME_INPUT || NAME_INPUT=""
        NAME_INPUT="${NAME_INPUT//[[:space:]]/}"
        [[ -z "$NAME_INPUT" ]] && NAME_INPUT="$NAME_SUGGEST"
        if ! valid_instance_name "$NAME_INPUT"; then
          echo "HATA: geçersiz isim: '$NAME_INPUT' — harf/rakam ile başlamalı; yalnızca harf, rakam, '.', '_', '-' içerebilir; 'default' ve 'all' ayrılmıştır." >&2
          exit 1
        fi
        if [[ -d "$INSTANCES_DIR/$NAME_INPUT" ]]; then
          echo "HATA: '$NAME_INPUT' adlı örnek zaten çalışıyor." >&2
          exit 1
        fi
        INSTANCE_NAME="$NAME_INPUT"
        if [[ "$PORT_EXPLICIT" == "1" ]]; then
          EFFECTIVE_PORT="$CFG_PORT"
          if port_busy "$EFFECTIVE_PORT"; then
            echo "HATA: --port $EFFECTIVE_PORT kullanımda; boş bir port belirtin." >&2
            exit 1
          fi
        else
          if ! EFFECTIVE_PORT="$(find_free_port "$CFG_PORT")"; then
            echo "HATA: $CFG_PORT sonrasında boş port bulunamadı." >&2
            exit 1
          fi
        fi
        echo "Yeni proxy '$INSTANCE_NAME' -> port $EFFECTIVE_PORT (öncekiler çalışmaya devam ediyor)."
        ;;
      *)
        echo "İptal edildi." >&2
        exit 1
        ;;
    esac
  fi
fi

CLIENT_HOST="$CFG_HOST"
[[ "$CLIENT_HOST" == "0.0.0.0" || "$CLIENT_HOST" == "::" ]] && CLIENT_HOST="127.0.0.1"
SERVER_URL="http://${CLIENT_HOST}:${EFFECTIVE_PORT}"
OPENAI_BASE="${SERVER_URL}/${PROVIDER}/v1"
# Claude Code (Anthropic SDK) yola kendisi /v1/messages ekler: taban URL "/v1" İÇERMEMELİ,
# yoksa istek /<provider>/v1/v1/messages olur, 404 döner ve "selected model" hatası görünür.
ANTHROPIC_BASE="${SERVER_URL}/${PROVIDER}"

# --- İstemci seçimi (model seçiminden SONRA) -------------------------------
if [[ "$FOREGROUND" != "1" && -z "${CLIENT:-}" ]]; then
  echo
  echo "İstemci seçimi:"
  select CLIENT_WORD in cline claude "pi cli (https://pi.dev)" "sadece proxy"; do
    [[ -n "$CLIENT_WORD" ]] && break
  done
  case "${CLIENT_WORD:-}" in
    cline)   CLIENT="cline" ;;
    claude)  CLIENT="claude" ;;
    pi*)     CLIENT="pi" ;;
    *)       CLIENT="none" ;;
  esac
  if [[ -z "${CLIENT_WORD:-}" ]]; then
    CLIENT="none"
    echo "Seçim yapılmadı; sadece proxy başlatılacak." >&2
  fi
fi

# Anahtarı olmayan bir provider ile istemci başlatmak yalnızca hata üretir:
# her istek upstream'ten 401 döner ve Claude Code hiçbir komut çalıştıramaz.
# Bu yüzden istemci seçiminden sonra anahtar kontrolü sert bir hataya dönüşür.
if [[ "$FOREGROUND" != "1" && "${CLIENT:-none}" != "none" && "$KEY_SET" != "yes" ]]; then
  echo "HATA: $PROVIDER için API anahtarı boş — $CLIENT başlatılmadı." >&2
  echo "  .env dosyasına ${API_KEY_ENV:-<sağlayıcı API anahtarı>} değerini ekleyin ve tekrar deneyin." >&2
  echo "  Yalnızca proxy'yi başlatmak isterseniz: bin/proxy-run $PROVIDER --client none" >&2
  exit 1
fi

if [[ "$CLIENT" == "cline" ]] && ! command -v cline >/dev/null 2>&1; then
  echo "UYARI: 'cline' bulunamadı (npm i -g cline); sadece proxy başlatılacak." >&2
  CLIENT="none"
fi

if [[ "$CLIENT" == "claude" ]] && ! command -v claude >/dev/null 2>&1; then
  echo "UYARI: 'claude' bulunamadı; sadece proxy başlatılacak." >&2
  CLIENT="none"
fi

# --- Pi CLI hazırlığı -------------------------------------------------------
# Pi anahtarı süreç ortamından okur; appProxy .env'sindeki anahtar
# src/providers/pi.mjs tarafından Pi'nin beklediği adla alt sürece aktarılır.
# Burada yalnızca kaba bir eksik-anahtar uyarısı yapılır.
if [[ "$CLIENT" == "pi" ]]; then
  if ! command -v pi >/dev/null 2>&1; then
    echo "UYARI: 'pi' (Pi Coding Agent, https://pi.dev) bulunamadı; sadece proxy başlatılacak." >&2
    CLIENT="none"
  elif [[ "$KEY_SET" != "yes" ]]; then
    echo "UYARI: $PROVIDER için ${API_KEY_ENV:-API anahtarı} boş; Pi ilk istekte 401 dönebilir." >&2
    echo "  Çözüm: .env'ye '${API_KEY_ENV}=<anahtar>' ekleyin." >&2
  fi
fi

print_summary() {
  echo
  echo "=========================================================="
  echo " appProxy hazır"
  [[ -n "${INSTANCE_NAME:-}" ]] && echo "  Örnek    : $INSTANCE_NAME"
  echo "=========================================================="
  echo "  Provider : $PROVIDER"
  echo "  Model    : $MODEL"
  echo "  Proxy    : $SERVER_URL"
  echo "  OpenAI   : $OPENAI_BASE  (POST /chat/completions, GET /models)"
  echo "  Anthropic: $ANTHROPIC_BASE  (POST /v1/messages)"
}

print_instructions() {
  print_summary
  echo
  echo "Cline CLI (openai-compatible):"
  echo "  cline auth openai-compatible -k \"\$PROXY_TOKEN\" -m \"$MODEL\" -b \"$OPENAI_BASE\""
  echo "  cline -P openai-compatible -m \"$MODEL\""
  echo
  echo "Claude Code (anthropic):"
  print_claude_env_exports "$ANTHROPIC_BASE" "$MODEL" "$FAST_MODEL"
  echo
  if [[ -n "${INSTANCE_NAME:-}" ]]; then
    echo "Durdurmak için : bin/proxy-run stop $INSTANCE_NAME"
  else
    echo "Durdurmak için : bin/proxy-run stop"
  fi
  echo "Durum          : bin/proxy-run status"
  echo
}

export PROXY_LOG_FILE="$LOG_FILE"
if [[ "$FOREGROUND" == "1" ]]; then
  rlog "foreground start provider=$PROVIDER model=$MODEL port=$EFFECTIVE_PORT"
  print_instructions
  echo "Proxy ön planda başlıyor (Ctrl+C ile durdur)..."
  exec node src/server.mjs "$PROVIDER"
fi

INST_DIR=""
if [[ -n "$INSTANCE_NAME" ]]; then
  INST_DIR="$INSTANCES_DIR/$INSTANCE_NAME"
  mkdir -p "$INST_DIR"
  OUT_FILE="logs/proxy-run-$INSTANCE_NAME.out"
  LOG_FILE="$ROOT_DIR/logs/proxy-run-$INSTANCE_NAME.log"
  export PROXY_LOG_FILE="$LOG_FILE"
fi
export PROXY_PORT="$EFFECTIVE_PORT"
rlog "session start provider=$PROVIDER model=$MODEL fast_model=${FAST_MODEL:-} client=${CLIENT:-none} port=$EFFECTIVE_PORT instance=${INSTANCE_NAME:-default}"

: > "$OUT_FILE"
# setsid: proxy, kendisini başlatan terminal kapanınca SIGHUP ile ölmesin
# diye kendi oturumunda açılır (setsid yoksa düz nohup'a düşülür).
if command -v setsid >/dev/null 2>&1; then
  setsid nohup node src/server.mjs "$PROVIDER" >> "$OUT_FILE" 2>&1 < /dev/null &
else
  nohup node src/server.mjs "$PROVIDER" >> "$OUT_FILE" 2>&1 < /dev/null &
fi
PID=$!
# project: bu proxy'yi hangi proje dizininden başlattığımız. `stop` ve `status`
# bu alanı kullanır; süreç dizini (ROOT_DIR) her zaman repo köküdür, proje değil.
if [[ -n "$INST_DIR" ]]; then
  echo "$PID" > "$INST_DIR/pid"
  echo "$PROVIDER" > "$INST_DIR/provider"
  echo "$MODEL" > "$INST_DIR/model"
  echo "$CFG_HOST" > "$INST_DIR/host"
  echo "$EFFECTIVE_PORT" > "$INST_DIR/port"
  printf '%s\n' "$PROJECT_DIR" > "$INST_DIR/project"
else
  echo "$PID" > "$PID_FILE"
  echo "$PROVIDER" > "$PROVIDER_FILE"
  echo "$MODEL" > "$MODEL_FILE"
  echo "$CFG_HOST" > "$HOST_FILE"
  echo "$EFFECTIVE_PORT" > "$PORT_FILE"
  printf '%s\n' "$PROJECT_DIR" > "$PROJECT_FILE"
fi

cleanup_failed_start() {
  if [[ -n "$INST_DIR" ]]; then
    rm -rf "$INST_DIR"
  else
    clear_default_files
  fi
}

rlog "proxy started pid=$PID log=$LOG_FILE out=$OUT_FILE"
echo "Proxy başlatıldı (pid $PID${INSTANCE_NAME:+, isim: $INSTANCE_NAME}, port: $EFFECTIVE_PORT). Sağlık kontrolü..."
for _ in {1..50}; do
  if curl -sf "${SERVER_URL}/health" >/dev/null 2>&1; then
    break
  fi
  if ! kill -0 "$PID" 2>/dev/null; then
    echo "HATA: proxy başlatılamadı. Son loglar:" >&2
    tail -n 30 "$OUT_FILE" >&2 || true
    cleanup_failed_start
    exit 1
  fi
  sleep 0.2
done

HEALTH_JSON="$(curl -sf "${SERVER_URL}/health" 2>/dev/null || true)"
# Sağlık yanıtı geldi ama yeni süreç ölmüşse (EADDRINUSE), yanıtı ESKİ bir proxy vermiştir.
sleep 0.3
if [[ -n "$HEALTH_JSON" ]] && ! kill -0 "$PID" 2>/dev/null; then
  echo "HATA: ${SERVER_URL} adresinde ESKİ bir proxy çalışıyor (yeni pid $PID portu alamadı)." >&2
  echo "      Durdurun: bin/proxy-run stop all   (gerekirse: pkill -f 'src/server.mjs')" >&2
  rlog "ERROR stale proxy on $SERVER_URL; new pid $PID did not bind"
  cleanup_failed_start
  kill "$PID" 2>/dev/null || true
  exit 1
fi
if [[ -z "$HEALTH_JSON" ]]; then
  echo "HATA: proxy 10 saniye içinde yanıt vermedi. Son loglar:" >&2
  tail -n 30 "$OUT_FILE" >&2 || true
  exit 1
fi

case "${CLIENT:-none}" in
  cline)
    print_summary
    echo
    echo "Cline CLI başlıyor (çıkmak için Ctrl+C). Proxy arkada çalışıyor; durdurmak için: bin/proxy-run stop${INSTANCE_NAME:+ $INSTANCE_NAME}"
    rlog "client start cline model=$MODEL base_url=$OPENAI_BASE"
    rc=0; run_cline_client "$OPENAI_BASE" "$MODEL" || rc=$?
    echo
    echo "Cline kapandı (kod $rc). Proxy çalışmaya devam ediyor."
    echo "Tekrar bağlanmak için: bin/proxy-run ${INSTANCE_NAME:-default} --client cline"
    exit "$rc"
    ;;
  claude)
    print_summary
    echo
    echo "Claude Code başlıyor (çıkmak için /exit). Proxy arkada çalışıyor; durdurmak için: bin/proxy-run stop${INSTANCE_NAME:+ $INSTANCE_NAME}"
    rlog "client start claude model=$MODEL fast_model=${FAST_MODEL:-} base_url=$ANTHROPIC_BASE"
    rc=0; run_claude_client "$ANTHROPIC_BASE" "$MODEL" "$FAST_MODEL" || rc=$?
    # İstemciden çıkıldı ama proxy ayakta: aynı örneğe dönmek için tek komut.
    echo
    echo "Claude Code kapandı (kod $rc). Proxy çalışmaya devam ediyor."
    echo "Tekrar bağlanmak için: bin/proxy-run ${INSTANCE_NAME:-default}"
    exit "$rc"
    ;;
  pi)
    print_summary
    echo
    echo "Pi CLI (https://pi.dev) başlatılıyor (çıkmak için /exit)."
    # Kurulum + doğrulama + başlatma tek noktadan: src/providers/pi.mjs.
    # Pi'nin yerleşik desteklemediği sağlayıcılar için ~/.pi/agent/models.json'a
    # otomatik özel provider tanımı yazılır; anahtar .env'den Pi'ye aktarılır.
    rlog "client start pi model=$MODEL"
    if ! node src/providers/pi.mjs "$PROVIDER" "$MODEL" "$ORIG_PWD"; then
      echo "UYARI: Pi CLI başlatılamadı; proxy arkada çalışıyor. Durum: bin/proxy-run status" >&2
    fi
    ;;
  *)
    print_instructions
    ;;
esac
